# ==============================================================================
# CHENNAI SENTINEL — GEOSPATIAL & MAP API CONFIGURATION
# ==============================================================================
# All keys are optional. If not provided, the platform automatically uses
# built-in, unmetered high-resolution CartoDB Dark Matter, Esri Satellite,
# and OpenStreetMap Vector tiles without requiring any external account.
# ==============================================================================

# 1. Mapbox Access Token (https://account.mapbox.com/)
# Unlocks: Mapbox Dark-v11, Mapbox Satellite Streets, Navigation Night
NEXT_PUBLIC_MAPBOX_TOKEN=

# 2. MapTiler API Key (https://cloud.maptiler.com/)
# Unlocks: MapTiler Dataviz Dark, High-Res Satellite Hybrid, Terrain Contours
NEXT_PUBLIC_MAPTILER_API_KEY=

# 3. Stadia Maps API Key (https://client.stadiamaps.com/)
# Unlocks: Alidade Smooth Dark, Stadia Satellite, Outdoors
NEXT_PUBLIC_STADIA_API_KEY=

# 4. OpenWeatherMap API Key (https://home.openweathermap.org/api_keys)
# Unlocks: Live Precipitation Radar, Wind & Cloud Vector Overlays for Chennai
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# 5. Google Maps Platform API Key (https://console.cloud.google.com/)
# Unlocks: Google Geocoding, Elevation Profiles, Satellite Imagery
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 6. OpenRouteService API Key (https://openrouteservice.org/)
# Unlocks: Real-world dynamic road impedance and isochrones
NEXT_PUBLIC_ORS_API_KEY=

# Backend API Base URL (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
